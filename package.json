{
  "name": "arc-image-studio",
  "version": "2.8.0",
  "description": "Estúdio local para otimizar, redimensionar, converter, renomear, proteger e transferir arquivos pelo Wi-Fi.",
  "type": "module",
  "main": "src/main.mjs",
  "author": "ARC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "generate:assets": "node scripts/generate-animations.mjs",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exifreader": "^4.52.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "gifenc": "^1.0.3"
  },
  "build": {
    "appId": "com.arc.imagestudio",
    "productName": "ARC Image Studio",
    "asar": true,
    "asarUnpack": [
      "vendor/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "files": [
      "src/**/*",
      "vendor/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "ARC-Image-Studio-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "MarcellResende",
        "repo": "arc.ImageStudio",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARC Image Studio"
    }
  }
}
